# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored. Do not commit real keys.

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. Which auto-tagging add-on to use on upload. Must be one you have
# registered on the Cloudinary Add-ons page.
# google_tagging (default) | imagga_tagging | aws_rek_tagging
CLOUDINARY_CATEGORIZATION=
